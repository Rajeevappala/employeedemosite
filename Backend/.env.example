# ==============================================================================
# GaintPro HRM Portal - Backend Environment Configuration Template
# All values shown below are non-sensitive examples / placeholders.
# DO NOT COMMIT REAL SECRETS OR SENSITIVE CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=development

# PostgreSQL Database Connection
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/employee_portal

# JWT Authentication
# In production, must be a cryptographically strong string (minimum 32 characters)
JWT_SECRET=your_secure_random_jwt_secret_key_min_32_chars
JWT_EXPIRES_IN=86400

# OTP Secret Salt
# Used to salt and hash 6-digit OTP codes before database persistence
OTP_SECRET=your_secure_random_otp_pepper_salt_string

# SMTP Email Delivery (Gmail / Standard SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
SMTP_USER=your_email@domain.com
SMTP_PASS=your_smtp_app_password
EMAIL_USER=your_email@domain.com
EMAIL_PASSWORD=your_smtp_app_password
EMAIL_FROM=GaintPro HRM <your_email@domain.com>

# Private Document Storage Path
# Absolute path or relative to project root
PRIVATE_STORAGE_PATH=./storage/private

# CORS Allowed Origin(s)
# Comma-separated list of allowed frontend origins (no trailing slashes)
CORS_ORIGIN=http://localhost:5173

# Rate Limiting Configuration (Optional overrides)
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_OTP_MAX=5
RATE_LIMIT_WINDOW_MS=900000
