# ==============================================================================
# GaintPro HRM Portal - Backend Environment Configuration Template
# PRODUCTION INSTRUCTIONS:
# Copy this file to .env and supply secure, real values.
# NEVER commit real credentials, passwords, or secrets to version control.
# ==============================================================================

# Server Environment
PORT=
NODE_ENV=

# PostgreSQL Database Connection
# Connection URI format: postgresql://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=

# PostgreSQL TLS / SSL Configuration
# Set to 'true' in production to enforce TLS encryption
DATABASE_SSL=
# Set to 'true' to verify server certificate (default in production). Set to 'false' only if self-signed cert is used.
DATABASE_SSL_REJECT_UNAUTHORIZED=
# Optional: Path to custom CA certificate file or inline PEM string
DATABASE_CA_CERT=
DATABASE_CA_CERT_PATH=

# JWT Authentication
# In production, must be a cryptographically secure random string with minimum 32 characters
JWT_SECRET=
# Token lifespan in seconds (default: 86400 = 24 hours)
JWT_EXPIRES_IN=

# OTP Security Salt / Pepper
# Used to hash ephemeral OTP codes before storage; minimum 16 characters in production
OTP_SECRET=
SESSION_SECRET=

# SMTP Email Configuration
# Hostname of the mail server (e.g., smtp.sendgrid.net, smtp.mailgun.org, smtp.gmail.com)
SMTP_HOST=
EMAIL_HOST=
# SMTP Port (465 for SSL/TLS, 587 for STARTTLS)
SMTP_PORT=
EMAIL_PORT=
# Set to 'true' for port 465, 'false' for STARTTLS on port 587
EMAIL_SECURE=
# SMTP Authentication Credentials
SMTP_USER=
EMAIL_USER=
SMTP_PASS=
EMAIL_PASSWORD=
# Sender header (e.g., GaintPro HRM <no-reply@yourcompany.com>)
EMAIL_FROM=

# Private Document Storage
# Directory path for confidential documents (payslips, tax forms, IDs).
# Not served statically; accessible only via authenticated RBAC endpoints.
PRIVATE_STORAGE_PATH=

# CORS Allowed Origin(s)
# Comma-separated list of allowed frontend origins (e.g., https://hrm.yourcompany.com)
# In production, explicit origins are required; localhost is blocked.
CORS_ORIGIN=

# Rate Limiting Configuration (Optional overrides; defaults applied if omitted)
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_AUTH_MAX=
RATE_LIMIT_OTP_MAX=
RATE_LIMIT_VERIFY_MAX=
RATE_LIMIT_UPLOAD_MAX=

# Bank Account Encryption Key (AES-256-GCM)
# 32-byte secret key (or 64-character hex string) used to encrypt bank account numbers at rest
BANK_ENCRYPTION_KEY=

